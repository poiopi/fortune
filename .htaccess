RewriteEngine On
RewriteBase /

# http → https リダイレクト
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# 開発用フォルダ（tools/docs/tests）はWebに公開しない（404を返す）
# 2026-09-24、本番に tools/*.php・*.sh と docs/love/*.json がアップロードされ外部から
# 実行・閲覧できる状態だったため追加（.vscode/sftp.json の除外設定との二重の守り）
# 2026-09-29、_scratch/（開発用のモックアップ）も本番で公開されていたため追加
RewriteRule ^(tools|docs|tests|_scratch)(/|$) - [R=404,L]

# ドット（.）で始まるファイル・フォルダ（.gitignore 等）は公開しない（404を返す）。/.well-known/（SSL証明書の更新等）は除く
# 2026-09-30、2026-07-03 の事故で上がった /.gitignore が本番に残り、外部から読める状態だったため追加
RewriteRule (^|/)\.(?!well-known(/|$)) - [R=404,L]

# 十干の解説記事は 2026-06-27 に articles/jikkan/ から articles/shichu/ へ移動した。
# サーバーに旧フォルダが残り同じ内容が2か所で公開されていたため（2026-09-29 管理画面のSEO点検で発見）、恒久的に転送する
RewriteRule ^articles/jikkan(/(.*))?$ /articles/shichu/$2 [R=301,L]

# 旧WordPressのURLを全部トップにリダイレクト
RewriteRule ^index\.php/.*$ / [R=301,L]

# .php拡張子を省略したURLへ301リダイレクト（index.phpは除外）
# GET/HEADのみを対象とする。301リダイレクトはPOSTボディを保持しないため、
# POSTフォーム（sansei.php等）を持つページで.php付きURLへ直接POSTされた場合に
# データが失われる問題があった（2026-07-06 Step5-B調査で発見）。
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/(?!index\.php)([^?\s]+)\.php[?\s] [NC]
RewriteRule ^ /%1 [R=301,L]

# 拡張子なしのURLで対応する.phpファイルを内部的に呼び出す
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^.]+)$ $1.php [L]