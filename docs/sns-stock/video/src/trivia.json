 {"text":"― 今日の豆知識 ―","size":44,"color":"#e8c96a","x":90,"y":170,"s":0.3},
 {"text":"十六夜","size":150,"font":"mincho","x":90,"y":280,"s":1.0},
 {"text":"いざよい","size":44,"color":"#c4a8f5","x":98,"y":470,"s":1.5},
 {"text":"満月の次の夜の月は、","size":50,"x":90,"y":640,"s":2.6},
 {"text":"満月の夜より少し遅れて昇ります。","size":50,"x":90,"y":715,"s":3.2},
 {"text":"その様子を、昔の人は","size":50,"x":90,"y":840,"s":4.6},
 {"text":"「月がためらっている」と","size":50,"x":90,"y":915,"s":5.2},
 {"text":"見立てました。","size":50,"x":90,"y":990,"s":5.8},
 {"text":"いざよう ＝ ためらう","size":56,"color":"#e8c96a","x":90,"y":1100,"s":7.6},
